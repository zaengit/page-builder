{
  "version": 1,
  "datasourceCases": {
    "validRequests": [
      {
        "provider": "database",
        "resource": "products",
        "mode": "single",
        "recordId": 42
      },
      {
        "provider": "database",
        "resource": "posts",
        "mode": "single",
        "contextKey": "currentPost.id"
      },
      {
        "provider": "database",
        "resource": "products",
        "mode": "collection",
        "query": {
          "where": [
            {"column": "status", "operator": "=", "value": "published"},
            {"column": "price", "operator": ">=", "value": 100}
          ],
          "orderBy": [
            {"column": "created_at", "direction": "desc"}
          ],
          "with": ["category", "images"],
          "limit": 12,
          "offset": 0
        }
      },
      {
        "provider": "database",
        "resource": "projects",
        "mode": "collection",
        "query": {
          "orderBy": [{"column": "position"}],
          "perPage": 20,
          "page": 2
        }
      }
    ],
    "invalidRequests": [
      {
        "provider": "database",
        "resource": "App\\Models\\Product"
      },
      {
        "provider": "database",
        "resource": "products",
        "mode": "collection",
        "query": {"limit": 10, "perPage": 10}
      },
      {
        "provider": "database",
        "resource": "products",
        "mode": "collection",
        "query": {"offset": 10, "perPage": 10}
      },
      {
        "provider": "database",
        "resource": "products",
        "query": {
          "where": [{"column": "status", "operator": "="}]
        }
      }
    ],
    "validResponses": [
      {"data": null, "diagnostics": []},
      {
        "data": {"id": 1, "name": "Example"},
        "diagnostics": []
      },
      {
        "data": {
          "items": [{"id": 1}, {"id": 2}],
          "pagination": {
            "currentPage": 1,
            "perPage": 20,
            "lastPage": 3,
            "total": 52,
            "hasMorePages": true
          }
        },
        "diagnostics": []
      }
    ]
  }
}
