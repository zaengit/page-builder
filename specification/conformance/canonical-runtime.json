{
  "version": 1,
  "registry": {
    "test/section": {
      "name": "test/section",
      "version": 1,
      "title": "Section",
      "category": "test",
      "template": "<section><h2>{{ attrs.title ?? \"Section\" }}</h2>{{{ children }}}</section>",
      "attributes": {"title": {"type": "string", "default": "Section"}},
      "assets": {"css": ["section.css"], "js": []}
    },
    "test/text": {
      "name": "test/text",
      "version": 1,
      "title": "Text",
      "category": "test",
      "template": "<p>{{ attrs.text }}</p>",
      "attributes": {"text": {"type": "string", "default": ""}},
      "assets": {"css": ["text.css", "section.css"], "js": ["text.js"]}
    },
    "test/context-card": {
      "name": "test/context-card",
      "version": 1,
      "title": "Context card",
      "category": "test",
      "template": "{% if context.product.available %}<strong>{{ attrs.label }}</strong>{% endif %}",
      "attributes": {"label": {"type": "string", "default": "Fallback"}},
      "assets": {"css": [], "js": []}
    }
  },
  "page": {
    "version": 1,
    "settings": {
      "contentWidth": "1200px",
      "tokens": {"radius": "8px"},
      "colorSchemes": [{"id": "dark", "name": "Dark", "colors": {"background": "#111", "foreground": "#fff"}}],
      "defaultColorSchemeId": "dark",
      "typography": {"families": {"primary": "Inter,sans-serif"}, "styles": {}},
      "customCss": ".pb-page .custom{display:block}"
    },
    "blocks": [
      {
        "id": "section-1",
        "type": "test/section",
        "attrs": {"title": "Hello <World>"},
        "children": [
          {
            "id": "text-1",
            "type": "test/text",
            "attrs": {"text": "Safe <script>"},
            "styles": {"fontSize": {"desktop": "16px", "mobile": "14px"}},
            "slot": "content",
            "colorSchemeId": "dark",
            "children": []
          },
          {
            "id": "context-1",
            "type": "test/context-card",
            "attrs": {},
            "bindings": {"label": {"source": "context", "path": "product.name", "fallback": "Unknown"}},
            "children": []
          }
        ]
      }
    ]
  },
  "context": {"product": {"name": "Phone & Tablet", "available": true}},
  "expected": {
    "html": "<div class=\"pb-page pb-color-scheme--dark\" style=\"max-width:1200px;--pb-radius:8px\"><div data-pb-style-id=\"section-1\" data-pb-id=\"section-1\" style=\"\"><section><h2>Hello &lt;World&gt;</h2><div data-pb-style-id=\"text-1\" data-pb-id=\"text-1\" class=\"pb-color-scheme--dark\" data-pb-color-scheme=\"dark\" data-pb-slot=\"content\" style=\"font-size:16px\"><p>Safe &lt;script&gt;</p></div><style data-pb-responsive=\"text-1\">@media(max-width:640px){[data-pb-style-id=\"text-1\"]{font-size:14px}}</style><div data-pb-style-id=\"context-1\" data-pb-id=\"context-1\" style=\"\"><strong>Phone &amp; Tablet</strong></div></section></div></div><style data-pb-color-schemes>.pb-color-scheme--dark{--pb-color-background:#111;--pb-color-foreground:#fff;background-color:var(--pb-color-background);color:var(--pb-color-foreground);}</style><style data-pb-typography>.pb-page{--pb-font-primary:Inter,sans-serif;--pb-font-secondary:Georgia,Cambria,serif;--pb-font-monospace:ui-monospace,SFMono-Regular,Menlo,monospace;font-family:var(--pb-font-primary);}</style><style data-pb-page-css>.pb-page .custom{display:block}</style>",
    "assets": {"css": ["section.css", "text.css"], "js": ["text.js"]},
    "diagnostics": []
  }
}
