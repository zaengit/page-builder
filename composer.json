{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "zaengit/page-builder",
  "description": "Universal React page builder distribution with Laravel and Go engines",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/cache": "^13.29",
    "illuminate/config": "^13.29",
    "illuminate/contracts": "^13.29",
    "illuminate/database": "^13.29",
    "illuminate/http": "^13.29",
    "illuminate/routing": "^13.29",
    "illuminate/support": "^13.29",
    "illuminate/validation": "^13.29",
    "illuminate/view": "^13.29"
  },
  "require-dev": {
    "larastan/larastan": "^3.10",
    "laravel/framework": "^13.29",
    "laravel/pint": "^1.30.5",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^13.3.2"
  },
  "autoload": {
    "psr-4": {
      "Zaengit\\PageBuilder\\": "src/",
      "Zaengit\\PageBuilder\\Engine\\Laravel\\": "engine/laravel/src/"
    }
  },
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["Zaengit\\PageBuilder\\PageBuilderServiceProvider"]}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G",
    "format:test": "pint --test"
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
