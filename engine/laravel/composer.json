{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "zaengit/page-builder-engine-laravel",
  "description": "Laravel engine and integration package for the Zaengit universal page builder specification",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/cache": "^13.29",
    "illuminate/config": "^13.29",
    "illuminate/contracts": "^13.29",
    "illuminate/database": "^13.29",
    "illuminate/http": "^13.29",
    "illuminate/routing": "^13.29",
    "illuminate/support": "^13.29",
    "illuminate/validation": "^13.29",
    "illuminate/view": "^13.29"
  },
  "require-dev": {
    "laravel/framework": "^13.29",
    "laravel/pint": "^1.30.5",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3.2"
  },
  "autoload": {
    "psr-4": {
      "Zaengit\\PageBuilder\\Engine\\Laravel\\": "src/",
      "Zaengit\\PageBuilder\\": "src/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests/"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Zaengit\\PageBuilder\\PageBuilderServiceProvider"
      ]
    },
    "page-builder": {
      "specification": 1,
      "page": 1,
      "block": 1,
      "datasource": 1,
      "renderer-protocol": 1,
      "template-language": 1
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G",
    "format:test": "pint --test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
